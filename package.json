    "demo:video": "node ops/record-demo.mjs",
    "demo:video:mp4": "node ops/webm-to-mp4.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.25.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
