{
  "name": "veilo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veilo — sealed-bid second-price auctions with publicly verifiable clearing prices on Zcash",
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "demo:audit": "node ops/verify-demo.mjs",
    "demo:states": "node ops/check-demo-states.mjs",
    "bid:build": "node ops/build-bid.mjs",
    "bid:check": "node ops/build-bid.mjs --check",
